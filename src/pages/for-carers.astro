---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import BottomCTA from '../components/BottomCTA.astro';
import PageHeader from '../components/PageHeader.astro';
import { BASE } from '../config';
---

<BaseLayout
  title="For Carers — Transplant Log"
  description="Transplant Log helps carers support their loved one's recovery after transplant. Track daily health, prepare for appointments, and check food safety together."
>
  <Navbar />
  <main id="main-content">
    <PageHeader
      title="For Carers"
      subtitle="Supporting someone through the first 6–12 months after transplant is a journey too."
    />

    <!-- Origin story -->
    <section class="py-16 md:py-24">
      <div class="max-w-site mx-auto px-6">
        <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
          <div class="flex-1">
            <div class="w-16 h-1 rounded-full bg-tp-sage mb-6"></div>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-tp-text mb-6">
              Built by a partner to support their loved one after a liver transplant
            </h2>
            <div class="space-y-4 text-tp-muted text-lg leading-relaxed">
              <p>
                Transplant Log was born from a real experience. After a loved one's liver transplant,
                the daily routine of tracking vitals, managing medications, watching for symptoms,
                and preparing for clinic appointments felt overwhelming.
              </p>
              <p>
                Existing tools were either too clinical, too complex, or required accounts and
                storing data online — none of which felt right for something so personal. Transplant Log was
                built to be the calm, simple tool we wished we'd had from day one.
              </p>
            </div>
          </div>
          <div class="flex-1 flex justify-center">
            <PhoneMockup label="App in use — daily overview (390x844)" screenshotSrc={`${BASE}screenshots/dashboard.png`} screenshotAlt="Transplant Log app daily overview showing filled health tracking tiles" />
          </div>
        </div>
      </div>
    </section>

    <!-- How carers benefit -->
    <section class="py-16 md:py-24 bg-tp-green-light">
      <div class="max-w-site mx-auto px-6">
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-tp-text mb-10 text-center">
          How Transplant Log helps carers
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="bg-tp-bg rounded-tp-lg p-6">
            <svg class="w-6 h-6 text-tp-green mb-3" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>
            <h3 class="font-serif font-semibold text-lg text-tp-text mb-2">Help with daily logging</h3>
            <p class="text-tp-muted text-sm leading-relaxed">
              Sit with your loved one and help them log their vitals, symptoms, and how they're feeling.
              The simple interface means you can do it together without any learning curve.
            </p>
          </div>
          <div class="bg-tp-bg rounded-tp-lg p-6">
            <svg class="w-6 h-6 text-tp-green mb-3" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            <h3 class="font-serif font-semibold text-lg text-tp-text mb-2">Prepare clinic questions together</h3>
            <p class="text-tp-muted text-sm leading-relaxed">
              Before each appointment, use the clinic prep feature to note down questions.
              You'll never walk out of a consultation wishing you'd asked something.
            </p>
          </div>
          <div class="bg-tp-bg rounded-tp-lg p-6">
            <svg class="w-6 h-6 text-tp-green mb-3" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12h20"/><path d="M20 12c0 4.4-3.6 8-8 8s-8-3.6-8-8"/><path d="M4 12c0-1.3.5-2.5 1.4-3.4C6.3 7.6 7.5 7.1 9 7c1.2 0 2.3.4 3 1 .7-.6 1.8-1 3-1 1.5.1 2.7.6 3.6 1.6.9.9 1.4 2.1 1.4 3.4"/></svg>
            <h3 class="font-serif font-semibold text-lg text-tp-text mb-2">Food safety for cooking and eating out</h3>
            <p class="text-tp-muted text-sm leading-relaxed">
              Quickly check which foods are safe when meal planning or eating out.
            </p>
          </div>
          <div class="bg-tp-bg rounded-tp-lg p-6">
            <svg class="w-6 h-6 text-tp-green mb-3" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 4v4a2 2 0 0 0 2 2h4"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M12 18v-6"/><path d="M9 15h6"/></svg>
            <h3 class="font-serif font-semibold text-lg text-tp-text mb-2">Share reports with the medical team</h3>
            <p class="text-tp-muted text-sm leading-relaxed">
              Export detailed reports before appointments so the whole care team can see
              how recovery is progressing — with real data to inform decisions.
            </p>
          </div>
        </div>
      </div>
    </section>

    <BottomCTA
      heading="Help your loved one start tracking"
      subtitle="Private and simple enough to use together."
    />
  </main>
  <Footer />
</BaseLayout>
