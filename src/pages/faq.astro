---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BottomCTA from '../components/BottomCTA.astro';
import PageHeader from '../components/PageHeader.astro';

const faqs = [
  {
    question: 'Is my data stored in the cloud?',
    answer: 'No. All your data is stored on your device, inside your web browser. Nothing is ever sent to a server. Your health information never leaves your device unless you choose to export a report.',
  },
  {
    question: 'Do I need to create an account?',
    answer: 'No. Renew works entirely without accounts, logins, or registration. Just open it and start tracking. There\'s no sign-up form, no email verification, and no passwords to remember.',
  },
  {
    question: 'What if I clear my browser data?',
    answer: 'Renew includes a backup and restore feature. You can export your data as a backup file at any time, and restore it if needed. We recommend backing up regularly, especially before clearing browser data or switching devices.',
  },
  {
    question: 'Can I use it on my computer?',
    answer: 'Yes. Renew works in any modern web browser — on phones, tablets, and computers. The interface is optimised for mobile but works well on larger screens too.',
  },
  {
    question: 'Does it work without internet after the first visit?',
    answer: 'Yes. Once you\'ve loaded Renew in your browser, it works fully offline. All features — logging, medications, food safety, reports — work without an internet connection. You only need to be online for the very first visit.',
  },
  {
    question: 'Is this recommended by doctors?',
    answer: 'Renew is a personal project built to support recovery tracking. It is not a medical device, has not been through clinical approval, and should not be used as a substitute for professional medical advice. Always follow the guidance of your transplant team.',
  },
  {
    question: 'Is it really free?',
    answer: 'Renew is free to use, with no ads. It\'s a passion project built with care for the transplant community.',
  },
  {
    question: 'Can I transfer my data to a new phone?',
    answer: 'Yes. Use the backup feature to export your data, then restore it on your new device. The backup file contains all your logs, medications, appointments, and settings.',
  },
  {
    question: 'Who built this?',
    answer: 'Renew was built by a developer to support their partner after a liver transplant. It grew from a personal need into a tool that could help other transplant recipients, carers, and care teams.',
  },
  {
    question: 'Is this specific to liver transplants?',
    answer: 'Renew was originally designed with liver transplant recovery in mind, but the tracking features — vitals, medications, symptoms, food safety, and clinic prep — are useful for any type of organ transplant recovery.',
  },
  {
    question: 'What does PWA mean?',
    answer: 'PWA stands for Progressive Web App. It means Renew is a website that can be installed on your device and used like a regular app — with an icon on your home screen, offline support, and a full-screen experience. No app store download required.',
  },
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
});
---

<BaseLayout
  title="FAQ — Renew"
  description="Frequently asked questions about Renew — privacy, data storage, compatibility, and more."
>
  <script slot="head" type="application/ld+json" set:html={faqJsonLd} />

  <Navbar />
  <main>
    <PageHeader
      title="Frequently Asked Questions"
      subtitle="Everything you need to know about Renew."
    />

    <!-- FAQ list -->
    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-6">
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-white rounded-tp-md border border-tp-border/50 shadow-tp overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 font-medium text-tp-text hover:text-tp-green transition-colors">
                <span>{faq.question}</span>
                <svg
                  class="faq-chevron w-5 h-5 shrink-0 text-tp-muted transition-transform duration-200"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-5 text-tp-muted leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <BottomCTA />
  </main>
  <Footer />
</BaseLayout>
