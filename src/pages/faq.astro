---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BottomCTA from '../components/BottomCTA.astro';
import PageHeader from '../components/PageHeader.astro';

const faqs = [
  {
    question: 'Is my information kept private?',
    answer: 'Yes. Everything you enter into Renew stays on your device. Nothing is sent anywhere else. Your health information never leaves your phone or computer unless you choose to download a report and share it yourself.',
  },
  {
    question: 'Do I need to create an account?',
    answer: 'No. Just open Renew and start using it straight away. There\'s no sign-up, no passwords, and no personal details needed.',
  },
  {
    question: 'What happens if I get a new phone?',
    answer: 'Renew has a backup feature that lets you save a copy of all your information. You can then load that backup onto your new device to pick up where you left off. We recommend saving a backup regularly.',
  },
  {
    question: 'Can I use it on my computer?',
    answer: 'Yes. Renew works on phones, tablets, and computers. It\'s designed with phones in mind but works well on bigger screens too.',
  },
  {
    question: 'How do I add Renew to my home screen?',
    answer: 'When you open Renew in your phone\'s browser, you should see an option to "Add to Home Screen" — on iPhone this is in the share menu, and on Android it usually appears as a banner or in the browser menu. Once added, Renew will appear as an icon on your home screen just like any other app, making it quick and easy to open every day.',
  },
  {
    question: 'Does it work without internet?',
    answer: 'Yes. Once you\'ve opened Renew for the first time, it works without an internet connection. You only need to be online for that very first visit.',
  },
  {
    question: 'Is this a medical app?',
    answer: 'Renew is a personal tool to help you keep track of your recovery. It is not a medical device and does not replace the advice of your transplant team. Always follow the guidance of your doctors and nurses.',
  },
  {
    question: 'Is it really free?',
    answer: 'Renew is free to use, with no ads. It\'s a passion project built with care for the transplant community.',
  },
  {
    question: 'Can my carer or clinician see my data?',
    answer: 'No. Your information is only visible to you, on your device. No one else can see it unless you choose to share it. You can download a report and send it by email, or bring it along to a clinic appointment.',
  },
  {
    question: 'Who built this?',
    answer: 'Renew was built by a partner to support their loved one after a liver transplant. It grew from a personal need into a tool that could help other transplant recipients, carers, and care teams.',
  },
  {
    question: 'Is this only for liver transplants?',
    answer: 'Renew was originally designed with liver transplant recovery in mind, but the features — tracking vitals, medications, symptoms, food safety, and clinic visits — are useful for any type of organ transplant recovery.',
  },
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
});
---

<BaseLayout
  title="FAQ — Renew"
  description="Frequently asked questions about Renew — privacy, data storage, compatibility, and more."
>
  <script slot="head" type="application/ld+json" set:html={faqJsonLd} />

  <Navbar />
  <main>
    <PageHeader
      title="Frequently Asked Questions"
      subtitle="Everything you need to know about Renew."
    />

    <!-- FAQ list -->
    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-6">
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-white rounded-tp-md border border-tp-border/50 shadow-tp overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 font-medium text-tp-text hover:text-tp-green transition-colors">
                <span>{faq.question}</span>
                <svg
                  class="faq-chevron w-5 h-5 shrink-0 text-tp-muted transition-transform duration-200"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-5 text-tp-muted leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <BottomCTA />
  </main>
  <Footer />
</BaseLayout>
