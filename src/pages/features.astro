---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FeatureSection from '../components/FeatureSection.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import BrowserMockup from '../components/BrowserMockup.astro';
import BottomCTA from '../components/BottomCTA.astro';
import PageHeader from '../components/PageHeader.astro';
import { BASE } from '../config';
---

<BaseLayout
  title="Features — Transplant Log"
  description="Explore Transplant Log's features: daily logging, medication tracking, trends, clinician reports, food safety, and clinic preparation."
>
  <Navbar />
  <main id="main-content">
    <PageHeader
      title="Features"
      subtitle="Simple, focused tools designed around the real needs of transplant recipients and their care teams."
    />

    <!-- Daily Logging -->
    <FeatureSection
      id="daily-logging"
      title="Daily Logging"
      description="Optionally record the things that matter most each day — vitals, pain, activity, sleep, mood, and more. Transplant Log makes it easy to build a habit of tracking without feeling overwhelmed, so you can see your progress evolve."
      highlights={[
        'Vitals: temperature, blood pressure, heart rate, weight',
        'Pain levels and location tracking',
        'Activity, sleep quality, mood, and appetite',
        'Bowel tracking and symptom logging',
        'Quick daily overview at a glance',
      ]}
      accentColor="#8fae8b"
    >
      <PhoneMockup label="Dashboard with filled daily log tiles (390×844)" screenshotSrc={`${BASE}screenshots/dashboard.png`} screenshotAlt="Transplant Log app dashboard showing filled daily log tiles for vitals, mood, sleep, pain, and activity" />
    </FeatureSection>

    <div class="border-t border-tp-border"></div>

    <!-- Medications -->
    <FeatureSection
      id="medications"
      title="Medication Tracking"
      description="Stay on top of your medication schedule with a clear, organised view. Medications are grouped by time of day so you always know what to take and when."
      highlights={[
        'Organised by morning, afternoon, evening, and night',
        'Common transplant medications already included',
        'Tap to mark doses as taken',
        'Simple add and edit interface',
      ]}
      accentColor="#8b9cc7"
      reverse
    >
      <PhoneMockup label="Medication tab view (390×844)" screenshotSrc={`${BASE}screenshots/medication.png`} screenshotAlt="Transplant Log medication tab showing scheduled medications grouped by time of day" />
    </FeatureSection>

    <div class="border-t border-tp-border"></div>

    <!-- Trends -->
    <FeatureSection
      id="trends"
      title="Trends &amp; Charts"
      description="See how your recovery is progressing over time. Interactive charts let you visualise patterns and spot changes that might be worth discussing with your team."
      highlights={[
        'Clear, visual charts that are easy to read',
        'View trends over 7, 14, 30, or 90 days',
        'Track vitals, symptoms, and whether medications were taken',
        'Visual patterns make changes easy to spot',
      ]}
      accentColor="#7ab8a8"
    >
      <PhoneMockup label="Trends page with charts (390×844)" screenshotSrc={`${BASE}screenshots/trends.png`} screenshotAlt="Transplant Log trends page showing pain, activity, weight, and mood charts over time" />
    </FeatureSection>

    <div class="border-t border-tp-border"></div>

    <!-- Clinician Reports -->
    <FeatureSection
      id="clinician-reports"
      title="Clinician Reports"
      description="Generate comprehensive, beautifully formatted reports to share with your medical team. Reports can be opened in any web browser, printed, or emailed."
      highlights={[
        'Summary statistics for any date range',
        'Visual trend charts included in the report',
        'Detailed daily log tables',
        'Works in any web browser — no special software needed',
        'Print-friendly layout',
      ]}
      accentColor="#c97070"
      reverse
    >
      <BrowserMockup label="Clinician report in browser view (1200×800)" screenshotSrc={`${BASE}screenshots/clinician-report.png`} screenshotAlt="Clinician recovery report showing summary statistics, mood distribution, and trend charts" />
    </FeatureSection>

    <div class="border-t border-tp-border"></div>

    <!-- Food Safety -->
    <FeatureSection
      id="food-safety"
      title="Food Safety Guide"
      description="Navigating dietary restrictions after transplant can be confusing. Transplant Log includes a searchable food safety guide to help you make safe choices."
      highlights={[
        'Searchable list of foods with safety ratings',
        'Clear categories: safe, caution, avoid',
        'Helpful when cooking at home or eating out',
        'Covers common post-transplant dietary restrictions',
      ]}
      accentColor="#d4a574"
    >
      <PhoneMockup label="Food list view (390×844)" screenshotSrc={`${BASE}screenshots/food-safety.png`} screenshotAlt="Transplant Log food safety guide showing lifetime restrictions and first 6 months food list" />
    </FeatureSection>

    <div class="border-t border-tp-border"></div>

    <!-- Clinic Appointments -->
    <FeatureSection
      id="clinic-appointments"
      title="Clinic Appointments"
      description="Prepare for appointments, note down questions in advance, and take notes during your visit — all in one place."
      highlights={[
        'Schedule upcoming appointments',
        'Prepare questions before your visit',
        'Take notes during the appointment',
        'Keep a history of past visits',
      ]}
      accentColor="#b8a0c9"
      reverse
    >
      <PhoneMockup label="Appointment detail view (390×844)" screenshotSrc={`${BASE}screenshots/appointment.png`} screenshotAlt="Transplant Log clinic appointment detail with date, time, and prepared questions" />
    </FeatureSection>

    <BottomCTA />
  </main>
  <Footer />
</BaseLayout>
