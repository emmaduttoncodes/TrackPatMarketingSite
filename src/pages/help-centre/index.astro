---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BottomCTA from '../../components/BottomCTA.astro';
import PageHeader from '../../components/PageHeader.astro';
import { BASE } from '../../config';

const topics = [
  {
    title: 'Getting Started',
    description: 'How to open Transplant Log, add it to your home screen, and set things up for the first time.',
    href: `${BASE}help-centre/getting-started/`,
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>',
    color: '#8fae8b',
  },
  {
    title: 'Daily Logging',
    description: 'How to record your vitals, pain, activity, sleep, mood, and more each day.',
    href: `${BASE}help-centre/daily-logging/`,
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>',
    color: '#8fae8b',
  },
  {
    title: 'Medications',
    description: 'How to track your scheduled medications, mark doses as taken, and log as-needed medicines.',
    href: `${BASE}help-centre/medications/`,
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" /><path d="m8.5 8.5 7 7" /></svg>',
    color: '#8b9cc7',
  },
  {
    title: 'Trends & Reports',
    description: 'How to view your recovery trends and create reports to share with your medical team.',
    href: `${BASE}help-centre/trends-and-reports/`,
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>',
    color: '#7ab8a8',
  },
  {
    title: 'Food Safety',
    description: 'How to check which foods to avoid, and how to use Waiter Mode when eating out.',
    href: `${BASE}help-centre/food-safety/`,
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 0 1 0 8h-1" /><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" /><line x1="6" y1="1" x2="6" y2="4" /><line x1="10" y1="1" x2="10" y2="4" /><line x1="14" y1="1" x2="14" y2="4" /></svg>',
    color: '#d4a574',
  },
  {
    title: 'Clinic Appointments',
    description: 'How to keep track of appointments, prepare questions, and take notes during visits.',
    href: `${BASE}help-centre/clinic-appointments/`,
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>',
    color: '#b8a0c9',
  },
  {
    title: 'Your Data & Privacy',
    description: 'How your data is stored, how to back it up, and what happens if you get a new phone.',
    href: `${BASE}help-centre/your-data/`,
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>',
    color: '#c97070',
  },
];
---

<BaseLayout
  title="Help Centre — Transplant Log"
  description="Step-by-step guides to help you get the most from Transplant Log. Simple, clear help for daily logging, medications, reports, and more."
>
  <Navbar />
  <main id="main-content">
    <PageHeader
      title="Help Centre"
      subtitle="Simple guides to help you get the most from Transplant Log. Take your time — there's no rush."
    />

    <section class="py-16 md:py-24">
      <div class="max-w-site mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {topics.map((topic) => (
            <a
              href={topic.href}
              class="group bg-white rounded-tp-lg border border-tp-border/50 shadow-tp p-6 hover:shadow-md hover:-translate-y-0.5 transition-all"
            >
              <div
                class="w-12 h-12 rounded-tp-sm flex items-center justify-center mb-4"
                style={`background-color: ${topic.color}15; color: ${topic.color};`}
              >
                <Fragment set:html={topic.icon} />
              </div>
              <h2 class="font-serif text-xl font-semibold text-tp-text group-hover:text-tp-green transition-colors mb-2">
                {topic.title}
              </h2>
              <p class="text-tp-muted text-sm leading-relaxed">
                {topic.description}
              </p>
            </a>
          ))}
        </div>

        <!-- Additional help -->
        <div class="mt-16 text-center">
          <p class="text-tp-muted mb-2">Can't find what you're looking for?</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href={`${BASE}faq/`} class="text-tp-green hover:underline font-medium">
              Check the FAQ
            </a>
            <span class="hidden sm:inline text-tp-border">|</span>
            <a href="mailto:emma@emmadutton.dev" class="text-tp-green hover:underline font-medium">
              Get in touch
            </a>
          </div>
        </div>
      </div>
    </section>

    <BottomCTA
      heading="Ready to start tracking?"
      subtitle="Open Transplant Log and try it for yourself — no account needed."
    />
  </main>
  <Footer />
</BaseLayout>
