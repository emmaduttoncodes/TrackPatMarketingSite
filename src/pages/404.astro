---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { BASE } from '../config';
---

<BaseLayout title="Page not found — Transplant Log">
  <Navbar />
  <main id="main-content" class="flex-1 flex items-center justify-center py-24">
    <div class="text-center px-6">
      <svg class="w-12 h-12 text-tp-green mx-auto mb-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 17 3.5s1.5 2.5-.5 6.5a5.3 5.3 0 0 0-1 3"/><path d="M11 20v-6"/><path d="M7 19.5c1.5-1 3-2 4-3.5"/><path d="M15 19.5c-1.5-1-3-2-4-3.5"/></svg>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-tp-text mb-4">Page not found</h1>
      <p class="text-tp-muted text-lg mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or may have moved.
      </p>
      <a
        href={BASE}
        class="inline-flex items-center gap-2 px-6 py-3 bg-tp-green text-white font-semibold rounded-tp-sm hover:bg-tp-green/90 transition-colors"
      >
        Back to home
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
