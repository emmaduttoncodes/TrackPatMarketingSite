---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Privacy — Renew"
  description="Renew's privacy statement. No data collection, no servers. Your health data stays on your device."
>
  <Navbar />
  <main>
    <PageHeader
      title="Privacy"
      subtitle="Your health data is yours. Full stop."
    />

    <!-- Privacy content -->
    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-6">
        <div class="bg-white rounded-tp-lg p-8 md:p-10 shadow-tp border border-tp-border/50">
          <div class="prose-like space-y-8">
            <div>
              <h2 class="font-serif text-xl font-bold text-tp-text mb-3">No data collection</h2>
              <p class="text-tp-muted leading-relaxed">
                Renew does not collect, store, or transmit any personal or health data.
                There are no servers, no databases, and no other companies handling
                your information. We have no way to access your information because it never
                leaves your device.
              </p>
            </div>

            <div class="border-t border-tp-border pt-8">
              <h2 class="font-serif text-xl font-bold text-tp-text mb-3">Local storage</h2>
              <p class="text-tp-muted leading-relaxed">
                All data you enter into Renew is saved on your device, inside your web
                browser. Your data is not accessible to anyone else — including us.
              </p>
            </div>

            <div class="border-t border-tp-border pt-8">
              <h2 class="font-serif text-xl font-bold text-tp-text mb-3">External requests</h2>
              <p class="text-tp-muted leading-relaxed">
                The only external connection Renew makes is to Google Fonts, which loads
                the text styles used in the app. Google's font service may collect some basic
                technical information when this happens, as described in
                <a href="https://developers.google.com/fonts/faq/privacy" class="text-tp-green hover:underline">
                  Google's privacy policy</a>.
              </p>
            </div>

            <div class="border-t border-tp-border pt-8">
              <h2 class="font-serif text-xl font-bold text-tp-text mb-3">No cookies or advertising</h2>
              <p class="text-tp-muted leading-relaxed">
                Renew does not use cookies, advertising networks, or social media connections.
                We use privacy-friendly, anonymous usage statistics to help improve the app —
                no personal data is collected and nothing is linked to you.
              </p>
            </div>

            <div class="border-t border-tp-border pt-8">
              <h2 class="font-serif text-xl font-bold text-tp-text mb-3">Data export</h2>
              <p class="text-tp-muted leading-relaxed">
                When you use the backup or clinician report features, files are generated
                entirely within your browser and saved directly to your device. No data is
                uploaded to any server during this process.
              </p>
            </div>
          </div>
        </div>

        <p class="text-center text-sm text-tp-muted mt-8">
          Last updated: February 2026
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
