---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="py-16 md:py-20 text-center bg-tp-gradient">
  <div class="max-w-site mx-auto px-6">
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-white mb-4">{title}</h1>
    <p class="text-white/90 text-lg max-w-2xl mx-auto">{subtitle}</p>
  </div>
</section>
