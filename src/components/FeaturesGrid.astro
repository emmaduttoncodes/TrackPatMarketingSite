---
import FeatureCard from './FeatureCard.astro';
import SectionHeading from './SectionHeading.astro';

import { BASE } from '../config';

const features = [
  {
    title: 'Daily Logging',
    description: 'Track vitals, pain levels, activity, sleep, mood, appetite, and symptoms with simple, tap-friendly tiles.',
    icon: '📋',
    color: '#8fae8b',
    href: `${BASE}features/#daily-logging`,
  },
  {
    title: 'Medications',
    description: 'Manage your medication schedule by time of day, with common transplant meds already included.',
    icon: '💊',
    color: '#8b9cc7',
    href: `${BASE}features/#medications`,
  },
  {
    title: 'Trends',
    description: 'See your recovery patterns over time with interactive charts you can explore by swiping.',
    icon: '📈',
    color: '#7ab8a8',
    href: `${BASE}features/#trends`,
  },
  {
    title: 'Clinician Reports',
    description: 'Generate detailed, exportable reports to share with your medical team at appointments.',
    icon: '🩺',
    color: '#c97070',
    href: `${BASE}features/#clinician-reports`,
  },
  {
    title: 'Food Safety',
    description: 'Check which foods are safe post-transplant, with a special Waiter Mode for eating out.',
    icon: '🥗',
    color: '#d4a574',
    href: `${BASE}features/#food-safety`,
  },
  {
    title: 'Clinic Prep',
    description: 'Schedule appointments, prepare questions in advance, and take notes during your visit.',
    icon: '📅',
    color: '#b8a0c9',
    href: `${BASE}features/#clinic-appointments`,
  },
];
---

<section class="py-16 md:py-24" id="features-overview">
  <div class="max-w-site mx-auto px-6">
    <SectionHeading
      title="Everything you need for recovery"
      subtitle="Simple, focused tools designed around the real needs of transplant recipients."
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((feature) => (
        <FeatureCard {...feature} />
      ))}
    </div>
  </div>
</section>
