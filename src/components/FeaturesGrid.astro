---
import FeatureCard from './FeatureCard.astro';
import SectionHeading from './SectionHeading.astro';

import { BASE } from '../config';

const features = [
  {
    title: 'Daily Logging',
    description: 'Track vitals, pain levels, activity, sleep, mood, appetite, and symptoms in a few quick taps.',
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>',
    color: '#8fae8b',
    href: `${BASE}features/#daily-logging`,
  },
  {
    title: 'Medications',
    description: 'Manage your medication schedule by time of day, with common transplant meds already included.',
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/></svg>',
    color: '#8b9cc7',
    href: `${BASE}features/#medications`,
  },
  {
    title: 'Trends',
    description: 'See your recovery patterns over time with clear, visual charts.',
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>',
    color: '#7ab8a8',
    href: `${BASE}features/#trends`,
  },
  {
    title: 'Clinician Reports',
    description: 'Generate detailed, exportable reports to share with your medical team at appointments.',
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 4v4a2 2 0 0 0 2 2h4"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M12 18v-6"/><path d="M9 15h6"/></svg>',
    color: '#c97070',
    href: `${BASE}features/#clinician-reports`,
  },
  {
    title: 'Food Safety',
    description: 'Check which foods are safe post-transplant, with a searchable guide for cooking and eating out.',
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12h20"/><path d="M20 12c0 4.4-3.6 8-8 8s-8-3.6-8-8"/><path d="M4 12c0-1.3.5-2.5 1.4-3.4C6.3 7.6 7.5 7.1 9 7c1.2 0 2.3.4 3 1 .7-.6 1.8-1 3-1 1.5.1 2.7.6 3.6 1.6.9.9 1.4 2.1 1.4 3.4"/></svg>',
    color: '#d4a574',
    href: `${BASE}features/#food-safety`,
  },
  {
    title: 'Clinic Prep',
    description: 'Schedule appointments, prepare questions in advance, and take notes during your visit.',
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>',
    color: '#b8a0c9',
    href: `${BASE}features/#clinic-appointments`,
  },
];
---

<section class="py-16 md:py-24" id="features-overview">
  <div class="max-w-site mx-auto px-6">
    <SectionHeading
      title="Everything you need for recovery"
      subtitle="Simple, focused tools designed for the first 6–12 months after transplant."
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((feature) => (
        <FeatureCard {...feature} />
      ))}
    </div>
  </div>
</section>
