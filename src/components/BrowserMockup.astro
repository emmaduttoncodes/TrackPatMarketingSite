---
interface Props {
  label: string;
  screenshotSrc?: string;
  screenshotAlt?: string;
}

const { label, screenshotSrc, screenshotAlt = '' } = Astro.props;
---

<!-- Browser mockup: replace placeholder with screenshot at 1200x800px -->
<div class="relative mx-auto max-w-[600px]">
  <div class="rounded-tp-md border border-tp-border bg-white shadow-tp overflow-hidden">
    <!-- Browser chrome -->
    <div class="flex items-center gap-2 px-4 py-2.5 bg-tp-card-alt border-b border-tp-border">
      <div class="flex gap-1.5">
        <div class="w-3 h-3 rounded-full bg-tp-coral/60"></div>
        <div class="w-3 h-3 rounded-full bg-tp-orange/60"></div>
        <div class="w-3 h-3 rounded-full bg-tp-green/60"></div>
      </div>
      <div class="flex-1 mx-2 px-3 py-1 bg-white rounded-md text-xs text-tp-muted truncate border border-tp-border">
        emmaduttoncodes.github.io/TrackPat/
      </div>
    </div>
    <!-- Content area -->
    <div class="aspect-[3/2]">
      {screenshotSrc ? (
        <img
          src={screenshotSrc}
          alt={screenshotAlt}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full bg-tp-green-light border-2 border-dashed border-tp-green/30 flex items-center justify-center p-6">
          <span class="text-tp-green text-sm text-center font-medium">{label}</span>
        </div>
      )}
    </div>
  </div>
</div>
