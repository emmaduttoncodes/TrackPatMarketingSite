---
const items = [
  { icon: '🔒', text: '100% private' },
  { icon: '📡', text: 'Works offline' },
  { icon: '💚', text: 'Free forever' },
  { icon: '🌿', text: 'Open source' },
];
---

<section class="bg-tp-green-light py-6" aria-label="Key benefits">
  <div class="max-w-site mx-auto px-6">
    <div class="flex flex-wrap justify-center gap-x-10 gap-y-4">
      {items.map((item) => (
        <div class="flex items-center gap-2.5 text-tp-green">
          <span class="text-lg" aria-hidden="true">{item.icon}</span>
          <span class="text-sm font-semibold">{item.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
