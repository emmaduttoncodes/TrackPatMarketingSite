---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
}

const { title, subtitle, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`mb-12 ${alignClass}`}>
  <h2 class="font-serif text-3xl md:text-4xl font-bold text-tp-text mb-4">{title}</h2>
  {subtitle && <p class={`text-tp-muted text-lg max-w-2xl ${align === 'center' ? 'mx-auto' : ''}`}>{subtitle}</p>}
</div>
