---
import { APP_URL, GITHUB_URL, BASE } from '../config';

const year = new Date().getFullYear();

const links = [
  { label: 'Features', href: `${BASE}features/` },
  { label: 'For Carers', href: `${BASE}for-carers/` },
  { label: 'For Clinicians', href: `${BASE}for-clinicians/` },
  { label: 'FAQ', href: `${BASE}faq/` },
  { label: 'Privacy', href: `${BASE}privacy/` },
];
---

<footer class="bg-white border-t border-tp-border mt-auto no-print">
  <div class="max-w-site mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between items-start gap-8">
      <!-- Branding -->
      <div class="flex flex-col gap-4">
        <a href={BASE} class="flex items-center gap-2.5 text-tp-text" aria-label="TrackPat home">
          <img src={`${BASE}icon.svg`} alt="" width="28" height="28" class="rounded-lg" />
          <span class="font-serif font-bold text-lg">TrackPat</span>
        </a>
        <p class="text-tp-muted text-sm max-w-xs">
          A calm, private companion for tracking your recovery after transplant.
        </p>
      </div>

      <!-- Nav links -->
      <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-8 gap-y-2">
        {links.map((link) => (
          <a href={link.href} class="text-sm text-tp-muted hover:text-tp-green transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- External links -->
      <div class="flex flex-col gap-3">
        <a
          href={APP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-tp-muted hover:text-tp-green transition-colors"
        >
          Open TrackPat &rarr;
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-tp-muted hover:text-tp-green transition-colors"
        >
          <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          View on GitHub
        </a>
        <a
          href={`${GITHUB_URL}/issues`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-tp-muted hover:text-tp-green transition-colors"
        >
          Questions or feedback?
        </a>
        <span class="inline-flex items-center gap-1.5 text-xs text-tp-muted bg-tp-green-light px-3 py-1 rounded-full w-fit">
          <svg class="w-3 h-3 text-tp-green" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Open Source
        </span>
      </div>
    </div>

    <!-- Support -->
    <div class="mt-8 pt-6 border-t border-tp-border text-center">
      <p class="text-tp-muted text-sm mb-3">
        TrackPat is a not-for-profit project. If it's helped you or someone you care about, you can say thanks.
      </p>
      <a
        href="https://buymeacoffee.com/emmadutt"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-tp-green-light text-tp-green text-sm font-semibold rounded-tp-sm hover:bg-tp-green hover:text-white transition-colors"
      >
        <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.062 2.014.13l.04.005c.11.013.265.033.354.033.088 0 .199-.02.313-.051.227-.061.414-.132.58-.214.166-.082.309-.18.468-.263a.866.866 0 01.208-.09c.2-.057.415-.076.623-.052.388.043.72.258.923.555a.673.673 0 01.089.181l.146.73c.057.286.233.544.489.648.166.067.35.089.533.063.301-.042.534-.268.617-.558.048-.168.075-.34.091-.512.011-.106.02-.213.026-.32 0-.022.003-.044.003-.066v-.094a1.153 1.153 0 00-.004-.19z" />
          <path d="M7.5 12.5c0 .552-.448 1-1 1s-1-.448-1-1 .448-1 1-1 1 .448 1 1z" />
          <path d="M18.933 13.783c-.052-.236-.162-.447-.276-.66a1.737 1.737 0 00-.37-.47 2.245 2.245 0 00-.686-.413c.033-.088.06-.178.08-.27.138-.612-.019-1.217-.156-1.773a6.932 6.932 0 00-.358-1.074 5.367 5.367 0 00-.232-.456.47.47 0 00-.083-.122.098.098 0 00-.037-.028c-.009-.003-.027-.006-.038 0-.075.035-.078.109-.053.175.058.151.139.31.196.463.128.346.236.7.32 1.06.067.288.165.68.1 1.007-.023.11-.068.217-.135.31-.05.07-.12.124-.2.159-.046.02-.094.031-.143.033a.496.496 0 01-.158-.01c.008-.09.01-.18.007-.27a4.46 4.46 0 00-.088-.754 5.083 5.083 0 00-.2-.699 4.236 4.236 0 00-.159-.384l-.016-.034c-.005-.01-.012-.02-.016-.03a.088.088 0 00-.055-.046c-.031-.008-.064.006-.079.035-.042.084.004.18.035.262.063.167.118.337.165.51.084.315.146.636.183.96.024.207.033.416.024.624a5.088 5.088 0 01-.317-.04c-.28-.042-.558-.1-.826-.183a3.47 3.47 0 01-.414-.155 4.49 4.49 0 00.292-.643 4.905 4.905 0 00.228-1.37c.012-.254.003-.508-.027-.76a1.202 1.202 0 00-.054-.252.084.084 0 00-.06-.053.066.066 0 00-.068.032c-.032.06-.008.135.002.2.02.131.036.263.044.396a4.66 4.66 0 01-.174 1.596c-.06.188-.137.37-.23.544-.258-.13-.492-.296-.707-.48a3.474 3.474 0 01-.536-.588c-.127-.178-.237-.368-.325-.568a.108.108 0 00-.05-.058.073.073 0 00-.074.014c-.035.032-.028.088-.003.13.095.167.203.327.322.478.244.308.533.581.856.808.173.12.361.223.556.306-.086.123-.183.239-.292.346-.332.33-.722.597-1.145.788a.097.097 0 00-.053.067.075.075 0 00.04.08c.03.016.068.008.096-.008.361-.198.692-.45.98-.748.114-.118.22-.243.317-.374.045.014.091.028.138.04.538.138 1.1.2 1.66.18.175-.006.35-.02.523-.043.048-.006.095-.013.142-.022.138.33.229.68.252 1.039.026.4-.038.8-.188 1.173a2.448 2.448 0 01-.658.923c-.273.232-.593.397-.937.488-.344.091-.702.108-1.053.048a2.358 2.358 0 01-.977-.438c-.286-.23-.52-.516-.687-.84a2.634 2.634 0 01-.264-1.068c-.01-.243.02-.488.088-.722.035-.118.054-.18-.067-.174-.084.004-.123.068-.147.147a2.694 2.694 0 00-.082.52c-.019.33.017.663.106.983.114.41.31.793.577 1.122.272.336.614.609 1.002.798.403.197.846.306 1.29.318.443.012.888-.066 1.297-.233a2.946 2.946 0 001.064-.737c.301-.32.53-.7.67-1.116.142-.42.192-.865.148-1.305a3.255 3.255 0 00-.287-1.064z" />
        </svg>
        Buy me a coffee
      </a>
    </div>

    <div class="mt-6 pt-6 border-t border-tp-border text-center text-xs text-tp-muted">
      <p>&copy; {year} TrackPat. Built with care for the transplant community.</p>
      <p class="mt-2">TrackPat is not a medical device and does not provide medical advice.</p>
    </div>
  </div>
</footer>
