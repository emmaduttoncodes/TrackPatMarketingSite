---
import { APP_URL, BASE } from '../config';

const year = new Date().getFullYear();

const links = [
  { label: 'Features', href: `${BASE}features/` },
  { label: 'For Carers', href: `${BASE}for-carers/` },
  { label: 'For Clinicians', href: `${BASE}for-clinicians/` },
  { label: 'Help Centre', href: `${BASE}help/` },
  { label: 'FAQ', href: `${BASE}faq/` },
  { label: 'Contact Us', href: 'mailto:emma@emmadutton.dev' },
];
---

<footer class="bg-white border-t border-tp-border mt-auto no-print">
  <div class="max-w-site mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between items-start gap-8">
      <!-- Branding -->
      <div class="flex flex-col">
        <a href={BASE} class="flex items-center gap-2.5 text-tp-text" aria-label="Transplant Log home">
          <img src={`${BASE}icon.svg`} alt="" width="60" height="60" class="rounded-lg" />
          <span class="font-serif font-bold text-lg">Transplant Log</span>
        </a>
        <p class="text-tp-muted text-sm max-w-xs ml-[70px]">
          A calm, private companion for tracking your recovery after transplant.
        </p>
      </div>

      <!-- Nav links -->
      <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-8 gap-y-2">
        {links.map((link) => (
          <a href={link.href} class="text-sm text-tp-muted hover:text-tp-green transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- External links -->
      <div class="flex flex-col gap-3">
        <a
          href={APP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-tp-muted hover:text-tp-green transition-colors"
        >
          Open App &rarr;
        </a>
      </div>
    </div>

  </div>

  <!-- Support -->
  <div class="border-t border-tp-border mt-8">
    <div class="max-w-site mx-auto px-6 pt-6 pb-0 text-center">
      <p class="text-tp-muted text-sm mb-3">
        Transplant Log is a not-for-profit project. If it's helped you or someone you care about, you can say thanks.
      </p>
      <a
        href="https://buymeacoffee.com/emmadutt"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-tp-green-light text-tp-green text-sm font-semibold rounded-tp-sm hover:bg-tp-green hover:text-white transition-colors"
      >
        <!-- Lucide "coffee" icon (MIT) -->
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M10 2v2" /><path d="M14 2v2" /><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2h-1" /><path d="M6 2v2" />
        </svg>
        Buy me a coffee
      </a>
    </div>
  </div>

  <div class="border-t border-tp-border mt-6">
    <div class="max-w-site mx-auto px-6 py-6 text-center text-xs text-tp-muted">
      <p>&copy; {year} Transplant Log. Built with care for the transplant community.</p>
      <p class="mt-2">Transplant Log is not a medical device and does not provide medical advice.</p>
    </div>
  </div>
</footer>
