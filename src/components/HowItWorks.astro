---
import SectionHeading from './SectionHeading.astro';
import { APP_URL } from '../config';

const steps = [
  {
    number: '1',
    title: 'Open',
    description: 'Visit Renew in your browser — no download or sign-up required.',
  },
  {
    number: '2',
    title: 'Install',
    description: 'Add it to your home screen for quick access — it works just like a regular app.',
  },
  {
    number: '3',
    title: 'Track',
    description: 'Start logging your daily recovery — everything stays on your device.',
  },
];
---

<section class="py-16 md:py-24 bg-tp-green-light">
  <div class="max-w-site mx-auto px-6">
    <SectionHeading
      title="Up and running in seconds"
      subtitle="No app store, no account, no waiting."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-3xl mx-auto">
      {steps.map((step) => (
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-white text-tp-green font-bold text-lg flex items-center justify-center mx-auto mb-4">
            {step.number}
          </div>
          <h3 class="font-serif font-bold text-xl text-tp-text mb-2">{step.title}</h3>
          <p class="text-tp-muted text-sm leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-tp-green font-semibold hover:underline"
      >
        Try Renew now
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <div class="mt-8 max-w-xl mx-auto bg-white rounded-tp-lg p-6 shadow-tp border border-tp-border/50">
        <h3 class="font-serif font-semibold text-lg text-tp-text mb-3">Adding Renew to your home screen</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-tp-muted leading-relaxed text-left">
          <div>
            <p class="font-semibold text-tp-text mb-1">iPhone</p>
            <p>Open Renew in Safari, tap the share button (the square with an arrow), then tap "Add to Home Screen".</p>
          </div>
          <div>
            <p class="font-semibold text-tp-text mb-1">Android</p>
            <p>Open Renew in Chrome and look for the "Add to Home Screen" banner, or tap the menu and select "Install app".</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
